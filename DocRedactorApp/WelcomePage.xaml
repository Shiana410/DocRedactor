<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocRedactorApp.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DocRedactorApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Modifiers="Control"
                Key="O"
                Invoked="CtrlO_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Toast-style InfoBar at the top, overlays full window width -->
        <InfoBar
            x:Name="UnsupportedFileBar"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Top"
            Margin="24,24,24,0"
            IsOpen="False"
            Severity="Warning"
            Title="Unsupported file"
            Message="DocRedactor only accepts .xps and .oxps files."
            Canvas.ZIndex="10"/>

        <!-- LEFT COLUMN (7) — original main structure, centered -->
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24"
            MaxWidth="480">

            <FontIcon
                Glyph="&#xE72E;"
                FontSize="80"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemAccentColorLight2}"/>

            <TextBlock
                Text="DocRedactor"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Detect and redact PII from XPS documents"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <Border
                x:Name="DropZone"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Padding="32"
                MinWidth="400"
                MinHeight="160"
                Margin="0,16,0,0">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        Glyph="&#xE8E5;"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="Drop an XPS or OXPS file here"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock
                Text="or"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center"/>

            <Button
                x:Name="OpenFileButton"
                Content="Open File..."
                Style="{ThemeResource AccentButtonStyle}"
                Click="OpenFileButton_Click"
                HorizontalAlignment="Center"
                MinWidth="160"/>
        </StackPanel>

        <!-- RIGHT COLUMN (3) — recent files panel, top-aligned -->
        <!-- RIGHT COLUMN (3) — recent files panel, top-aligned, wrapped in a card -->
        <Border
            Grid.Column="1"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8,24,24,24"
            Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row: title + Clear button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Recent files"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"/>

                    <Button
                        x:Name="ClearRecentsButton"
                        Grid.Column="1"
                        Content="Clear"
                        Click="ClearRecentsButton_Click"
                        Style="{ThemeResource DefaultButtonStyle}"
                        IsEnabled="False"
                        MinWidth="0"
                        Padding="12,4"/>
                </Grid>

                <!-- The list itself, or the empty-state hint -->
                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="RecentsEmptyText"
                        Text="No recent files"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="Visible"/>

                    <ListView
                        x:Name="RecentsList"
                        Visibility="Collapsed"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="RecentsList_ItemClick"
                        Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>