<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocRedactorApp.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DocRedactorApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Review"
            Style="{ThemeResource TitleTextBlockStyle}"/>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            Spacing="4"
            Margin="0,16,0,0">
            <TextBlock
                Text="Selected file"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock
                x:Name="FilePathText"
                Text="(no file)"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"/>
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            x:Name="ResultSummaryText"
            Text=""
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Margin="0,24,0,8"/>

        <!-- Two-pane content area -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: page preview -->
            <Border
                Grid.Column="0"
                x:Name="PreviewBorder"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}">

                <ScrollViewer
                    x:Name="PreviewScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16"
                    SizeChanged="PreviewScrollViewer_SizeChanged">
                    <StackPanel
                        x:Name="PreviewStack"
                        Orientation="Vertical"
                        Spacing="16"
                        HorizontalAlignment="Center">
                        <!-- Placeholder shown until pages render in Phase 3 -->
                        <TextBlock
                            x:Name="PreviewPlaceholderText"
                            Text="Page preview will appear here"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANE: match list -->
            <Grid Grid.Column="1">
                <Border
                    x:Name="PlaceholderBorder"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    Padding="24"
                    Visibility="Visible">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            Glyph="&#xE7C3;"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock
                            Text="PII detection results will appear here"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="MatchesBorder"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    Visibility="Collapsed">
                    <ListView
                        x:Name="MatchesList"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Padding="8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PiiMatchViewModel">
                                <Grid Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{x:Bind ShouldMask, Mode=TwoWay}"
                                        MinWidth="0"
                                        Padding="4,0,8,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Description}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap"
                                        FontFamily="Consolas"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom action buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="RedactButton"
                    Content="Redact and Save..."
                    Click="RedactButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="False"
                    MinWidth="160"/>
                <Button
                    x:Name="BackButton"
                    Content="Back"
                    Click="BackButton_Click"
                    MinWidth="100"/>
            </StackPanel>
        </Grid>

        <!-- Status InfoBar (overlaid at top of grid) -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            Grid.RowSpan="5"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            IsOpen="False"
            Canvas.ZIndex="10"/>
    </Grid>
</Page>