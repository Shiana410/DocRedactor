<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocRedactorApp.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DocRedactorApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Review"
            Style="{ThemeResource TitleTextBlockStyle}"/>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            Spacing="4"
            Margin="0,16,0,0">
            <TextBlock
                Text="Selected file"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock
                x:Name="FilePathText"
                Text="(no file)"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"/>
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            x:Name="ResultSummaryText"
            Text=""
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Margin="0,24,0,8"/>

        <Grid Grid.Row="3" Margin="0,0,0,0">
            <!-- Placeholder shown when no results yet -->
            <Border
                x:Name="PlaceholderBorder"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Padding="24"
                Visibility="Visible">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        Glyph="&#xE7C3;"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock
                        Text="PII detection results will appear here"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ListView shown when there are results -->
            <Border
                x:Name="SegmentsBorder"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Visibility="Collapsed">
                <ListView
                    x:Name="SegmentsList"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="8">
                </ListView>
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">
            <Button
                x:Name="BackButton"
                Content="Back"
                Click="BackButton_Click"
                MinWidth="100"/>
        </StackPanel>
    </Grid>
</Page>