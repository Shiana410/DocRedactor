<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DocRedactorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DocRedactorApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DocRedactor">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE7C5;" FontSize="16" Margin="12,0,8,0" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="DocRedactor" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>

            <Button Grid.Column="3" x:Name="SettingsButton" Click="SettingsButton_Click"
                    Background="Transparent" BorderThickness="0" Width="44" Height="32" Padding="0">
                <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</Window>